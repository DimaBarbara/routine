# Порт Nest API
PORT=4000

# Адреса Next.js застосунку: CORS і посилання в інвайтах
WEB_URL=http://localhost:3000

# Postgres із docker-compose.yml у корені
DATABASE_URL=postgresql://routine:routine@localhost:5433/routine?schema=public

# Secure-cookie вимагає HTTPS; локально — false
COOKIE_SECURE=false

# Перший адмін створюється командою `pnpm db:seed`
ADMIN_EMAIL=admin@routine.local
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Admin
