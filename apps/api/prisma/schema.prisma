generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  // Кожен модуль — у власній схемі Postgres: межі модулів видно прямо в базі.
  schemas  = ["public", "wishlist"]
}

enum Role {
  OWNER
  MEMBER

  @@schema("public")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// Лише адмін може видавати реєстраційні інвайти (spaceId = null).
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      Membership[]
  sessions         Session[]
  wishlists        Wishlist[]
  wishReservations WishReservation[]
  invitesCreated   Invite[]          @relation("InviteCreatedBy")
  invitesAccepted  Invite[]          @relation("InviteAcceptedBy")

  @@schema("public")
}

/// Серверна сесія: у cookie лежить сирий токен, у БД — лише його sha256.
model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("public")
}

/// Простір даних. Усі доменні таблиці модулів посилаються сюди через spaceId.
model Space {
  id         String   @id @default(cuid())
  name       String
  isPersonal Boolean  @default(false)
  createdAt  DateTime @default(now())

  memberships Membership[]
  invites     Invite[]
  wishlists   Wishlist[]

  @@schema("public")
}

model Membership {
  userId   String
  spaceId  String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([userId, spaceId])
  @@index([spaceId])
  @@schema("public")
}

/// spaceId = null — реєстраційний інвайт; інакше — запрошення в простір.
/// Одноразовий: після використання заповнюється acceptedAt.
model Invite {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  email        String
  role         Role      @default(MEMBER)
  spaceId      String?
  createdById  String
  acceptedById String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  space      Space? @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy  User   @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User?  @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([createdById])
  @@schema("public")
}

// ─── Модуль вішліста ─────────────────────────────────────────────────────────

enum WishPriority {
  LOW
  MEDIUM
  HIGH

  @@schema("wishlist")
}

model Wishlist {
  id          String   @id @default(cuid())
  spaceId     String
  /// Для кого список. Лише ця людина не бачить резервацій — інакше зникає сюрприз.
  ownerId     String
  title       String
  description String?
  /// Токен публічного посилання; null — посилання вимкнене.
  shareToken  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  owner User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@index([spaceId])
  @@schema("wishlist")
}

model WishlistItem {
  id         String       @id @default(cuid())
  wishlistId String
  title      String
  url        String?
  imageUrl   String?
  /// Ціна в мінорних одиницях (копійках). Гроші ніколи не зберігаємо у float.
  priceMinor Int?
  currency   String       @default("UAH") @db.Char(3)
  priority   WishPriority @default(MEDIUM)
  note       String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  wishlist    Wishlist         @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  reservation WishReservation?

  @@index([wishlistId])
  @@schema("wishlist")
}

/// Одна резервація на бажання (унікальний itemId). Або користувач, або гість за посиланням.
model WishReservation {
  id             String   @id @default(cuid())
  itemId         String   @unique
  userId         String?
  guestName      String?
  /// sha256 cookie гостя — щоб гість міг скасувати саме свою резервацію.
  guestTokenHash String?
  createdAt      DateTime @default(now())

  item WishlistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guestTokenHash])
  @@schema("wishlist")
}
