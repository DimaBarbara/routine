generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  // Кожен модуль — у власній схемі Postgres: межі модулів видно прямо в базі.
  schemas  = ["public", "wishlist", "finance"]
}

enum Role {
  OWNER
  MEMBER

  @@schema("public")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  /// Лише адмін може видавати реєстраційні інвайти (spaceId = null).
  isAdmin         Boolean   @default(false)
  /// Версія фото для URL (/api/users/:id/avatar?v=…): змінилась — браузер тягне нове, інакше бере з кешу.
  avatarUpdatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships                Membership[]
  sessions                   Session[]
  wishItems                  WishItem[]           @relation("WishOwner")
  wishItemsCreated           WishItem[]           @relation("WishCreatedBy")
  wishReservations           WishReservation[]
  wishShareLinks             WishShareLink[]
  financeTransactionsMade    FinanceTransaction[] @relation("FinanceTransactionPerson")
  financeTransactionsCreated FinanceTransaction[] @relation("FinanceTransactionCreatedBy")
  recurringIncomes           RecurringIncome[]
  cashEntries                CashEntry[]
  deposits                   Deposit[]
  invitesCreated             Invite[]             @relation("InviteCreatedBy")
  invitesAccepted            Invite[]             @relation("InviteAcceptedBy")
  userAvatars                UserAvatar[]

  @@schema("public")
}

/// Фото профілю окремо від User: байти не мають тягнутись у кожен запит сесії.
/// Невеликий JPEG/PNG/WebP (браузер стискає до 256px) — простіше, ніж окреме сховище на цьому масштабі.
model UserAvatar {
  userId    String   @id
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

/// Серверна сесія: у cookie лежить сирий токен, у БД — лише його sha256.
model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("public")
}

/// Простір даних. Усі доменні таблиці модулів посилаються сюди через spaceId.
model Space {
  id         String   @id @default(cuid())
  name       String
  isPersonal Boolean  @default(false)
  createdAt  DateTime @default(now())

  memberships         Membership[]
  invites             Invite[]
  wishItems           WishItem[]
  wishShareLinks      WishShareLink[]
  financeTransactions FinanceTransaction[]
  recurringIncomes    RecurringIncome[]
  cashEntries         CashEntry[]
  deposits            Deposit[]

  @@schema("public")
}

model Membership {
  userId   String
  spaceId  String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([userId, spaceId])
  @@index([spaceId])
  @@schema("public")
}

/// spaceId = null — реєстраційний інвайт; інакше — запрошення в простір.
/// Одноразовий: після використання заповнюється acceptedAt.
model Invite {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  email        String
  role         Role      @default(MEMBER)
  spaceId      String?
  createdById  String
  acceptedById String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  space      Space? @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy  User   @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User?  @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([createdById])
  @@schema("public")
}

// ─── Модуль вішліста ─────────────────────────────────────────────────────────
// Одна канбан-дошка на простір: колонка — статус, категорія — поле бажання.

enum WishStatus {
  WANT
  NEED
  THINKING
  DONE

  @@schema("wishlist")
}

enum WishDoneKind {
  BOUGHT
  GIFTED

  @@schema("wishlist")
}

enum WishCategory {
  CLOTHES
  BEAUTY
  SPORT
  TECH
  HOME
  BOOKS
  HOBBY
  TRAVEL
  HEALTH
  KIDS
  FOOD
  OTHER

  @@schema("wishlist")
}

enum WishPriority {
  LOW
  MEDIUM
  HIGH

  @@schema("wishlist")
}

model WishItem {
  id          String        @id @default(cuid())
  spaceId     String
  /// Для кого бажання; null — спільне на весь простір. Лише ця людина не бачить резервацій.
  ownerId     String?
  createdById String?
  title       String
  url         String?
  imageUrl    String?
  /// Ціна в мінорних одиницях (копійках). Гроші ніколи не зберігаємо у float.
  priceMinor  Int?
  currency    String        @default("UAH") @db.Char(3)
  priority    WishPriority  @default(MEDIUM)
  category    WishCategory  @default(OTHER)
  note        String?
  status      WishStatus    @default(WANT)
  /// Порядок у колонці. Дробовий: вставка між сусідами не переписує решту карток.
  position    Float
  doneKind    WishDoneKind?
  doneAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  space       Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  owner       User?            @relation("WishOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy   User?            @relation("WishCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reservation WishReservation?

  @@index([spaceId, status, position])
  @@schema("wishlist")
}

/// Одна резервація на бажання (унікальний itemId). Або користувач, або гість за посиланням.
model WishReservation {
  id             String   @id @default(cuid())
  itemId         String   @unique
  userId         String?
  guestName      String?
  /// sha256 cookie гостя — щоб гість міг скасувати саме свою резервацію.
  guestTokenHash String?
  createdAt      DateTime @default(now())

  item WishItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guestTokenHash])
  @@schema("wishlist")
}

/// Особисте публічне посилання: показує бажання людини в цьому просторі, щоб друзі могли резервувати.
model WishShareLink {
  id        String   @id @default(cuid())
  spaceId   String
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@schema("wishlist")
}

// ─── Модуль фінансів ─────────────────────────────────────────────────────────
// Гроші — цілі копійки (minor units), ставки — базисні пункти (15% = 1500). Жодних float у даних.

enum TransactionType {
  EXPENSE
  INCOME

  @@schema("finance")
}

enum ExpenseCategory {
  FOOD
  CAFE
  ENTERTAINMENT
  TRANSPORT
  HOME
  UTILITIES
  HEALTH
  BEAUTY
  CLOTHES
  SUBSCRIPTIONS
  EDUCATION
  TRAVEL
  GIFTS
  OTHER

  @@schema("finance")
}

enum IncomeKind {
  FIXED
  UNPLANNED

  @@schema("finance")
}

enum ContributionKind {
  INITIAL
  SCHEDULED
  EXTRA

  @@schema("finance")
}

model FinanceTransaction {
  id                String           @id @default(cuid())
  spaceId           String
  type              TransactionType
  amountMinor       Int
  currency          String           @db.Char(3)
  /// Лише для витрат.
  category          ExpenseCategory?
  /// Лише для доходів.
  incomeKind        IncomeKind?
  note              String?
  date              DateTime         @db.Date
  /// Хто витратив / заробив — учасник простору.
  personId          String?
  createdById       String?
  /// Згенеровано з регулярного доходу.
  recurringIncomeId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  space           Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  person          User?            @relation("FinanceTransactionPerson", fields: [personId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("FinanceTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  recurringIncome RecurringIncome? @relation(fields: [recurringIncomeId], references: [id], onDelete: SetNull)

  @@unique([recurringIncomeId, date])
  @@index([spaceId, date])
  @@schema("finance")
}

/// «Зарплата щомісяця 5-го». Операції створюються ліниво при читанні — на Render free крон ненадійний.
model RecurringIncome {
  id               String    @id @default(cuid())
  spaceId          String
  title            String
  amountMinor      Int
  currency         String    @db.Char(3)
  /// 1–31; у коротких місяцях — останній день.
  dayOfMonth       Int
  startDate        DateTime  @db.Date
  endDate          DateTime? @db.Date
  personId         String?
  pausedAt         DateTime?
  /// До якої дати операції вже створено. Видалена вручну операція не відродиться.
  generatedThrough DateTime? @db.Date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  space        Space                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  person       User?                @relation(fields: [personId], references: [id], onDelete: SetNull)
  transactions FinanceTransaction[]

  @@index([spaceId])
  @@schema("finance")
}

/// Одна скарбничка готівки на простір: + відклав, − взяв. Валют може бути кілька.
model CashEntry {
  id          String   @id @default(cuid())
  spaceId     String
  amountMinor Int
  currency    String   @db.Char(3)
  date        DateTime @db.Date
  note        String?
  personId    String?
  createdAt   DateTime @default(now())

  space  Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  person User? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([spaceId, date])
  @@schema("finance")
}

model Deposit {
  id                String    @id @default(cuid())
  spaceId           String
  name              String
  bank              String?
  currency          String    @db.Char(3)
  annualRateBp      Int
  /// 2300 = 23% (18% ПДФО + 5% військовий збір).
  taxRateBp         Int       @default(2300)
  /// true — відсотки додаються до суми щомісяця; false — виплачуються окремо.
  capitalization    Boolean   @default(true)
  /// Внески на депозит зменшують залишок місяця (як витрата, але окремим рядком).
  deductFromIncome  Boolean   @default(true)
  startDate         DateTime  @db.Date
  /// null — безстроковий.
  termMonths        Int?
  monthlyTopUpMinor Int       @default(0)
  topUpDay          Int
  personId          String?
  generatedThrough  DateTime? @db.Date
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  space         Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  person        User?                 @relation(fields: [personId], references: [id], onDelete: SetNull)
  contributions DepositContribution[]

  @@index([spaceId])
  @@schema("finance")
}

model DepositContribution {
  id           String           @id @default(cuid())
  depositId    String
  kind         ContributionKind
  amountMinor  Int
  date         DateTime         @db.Date
  /// Лише для планових: дата за графіком. Унікальна — навіть якщо два запити генерують одночасно.
  scheduledFor DateTime?        @db.Date
  note         String?
  createdAt    DateTime         @default(now())

  deposit Deposit @relation(fields: [depositId], references: [id], onDelete: Cascade)

  @@unique([depositId, scheduledFor])
  @@index([depositId, date])
  @@schema("finance")
}

/// Офіційний курс НБУ: гривень за одиницю валюти × 10 000 (44.5526 → 445526).
model ExchangeRate {
  date       DateTime @db.Date
  currency   String   @db.Char(3)
  rateScaled Int
  createdAt  DateTime @default(now())

  @@id([currency, date])
  @@schema("finance")
}
